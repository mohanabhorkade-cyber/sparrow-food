# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Environment
NODE_ENV=production
PORT=5000

# # Email Configuration (SendGrid)
# EMAIL_API_KEY=your-sendgrid-api-key
# CONTACT_EMAIL=contact@sparrowfood.com
# Email Configuration (Resend)
# Get API key from https://resend.com/api-keys
EMAIL_API_KEY=your-resend-api-key-here
CONTACT_EMAIL=your-contact-email@example.com

# Security
# ALLOWED_ORIGINS=http://localhost:4200,https://sparrowfood.com
# ALLOWED_ORIGINS=http://localhost:4200,https://sparrowfood.com,https://www.sparrowfood.com,https://delightful-douhua-10175a.netlify.app
# ALLOWED_ORIGINS=http://localhost:4200,https://sparrowfood.com,https://www.sparrowfood.com,https://*.railway.app
ALLOWED_ORIGINS=https://sparrowfood.com,https://www.sparrowfood.com,https://*.railway.app

LOG_LEVEL=info

# Production settings
# NODE_ENV=production
# EMAIL_API_KEY=your-sendgrid-api-key
# CONTACT_EMAIL=admin@sparrowfood.com
# ALLOWED_ORIGINS=https://sparrowfood.com,https://www.sparrowfood.com