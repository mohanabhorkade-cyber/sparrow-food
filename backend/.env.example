# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Environment
NODE_ENV=development
PORT=5000

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
CONTACT_EMAIL=contact@sparrowfood.com

# Security
ALLOWED_ORIGINS=http://localhost:4200,https://sparrowfood.com
LOG_LEVEL=info

# Production settings
# NODE_ENV=production
# EMAIL_USER=admin@sparrowfood.com
# EMAIL_PASSWORD=your-secure-app-password
# CONTACT_EMAIL=admin@sparrowfood.com
# ALLOWED_ORIGINS=https://sparrowfood.com,https://www.sparrowfood.com